+void NetworkGraph::applyCheckpointBlocks(
+  const std::vector<CheckpointBlock> &checkpoint_blocks) {
+
+  ml_logi("Applying %zu checkpoint blocks to the graph",
+          checkpoint_blocks.size());
+
+  for (const auto &block : checkpoint_blocks) {
+    if (!block.isEnabled()) {
+      continue;
+    }
