+
+              // Early drop: pages no longer needed; helps lower peak RSS during
+              // overlap
+              (void)::posix_madvise(mmap_ptr, f_size, POSIX_MADV_DONTNEED);
+
+              ::munmap(mmap_ptr, f_size);
+            }
+#else
