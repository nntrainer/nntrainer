#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1


# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

ROOT_DIR:=$(shell pwd)
export DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
export DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifdef unit_test
	export ENABLE_REDUCE_TOLERANCE ?= false
	export ENABLE_DEBUG?= true
else
	export ENABLE_REDUCE_TOLERANCE ?= true
	export ENABLE_DEBUG?= false
endif

# A distribution package has to run on every CPU it can be installed on, so
# drop i8mm from the tuned default (armv8.2-a+dotprod+i8mm): the build daemons
# and many arm64 machines do not implement it, and nntrainer selects its i8mm
# kernels at compile time, so a tuned build dies with SIGILL there.
# dotprod is kept because the KleidiAI int4 (QS4CX) micro-kernels are hand
# encoded and issue SDOT whatever -march says, so it is the real floor of this
# package anyway. Native builds are unaffected.
ifeq ($(DEB_HOST_ARCH),arm64)
	MESON_ARM_ARGS = -Darm-march=armv8.2-a+dotprod
endif

%:
	dh $@ --parallel

override_dh_auto_clean:
	rm -rf build

override_dh_auto_configure:
	mkdir -p build
	meson --buildtype=plain --prefix=/usr --sysconfdir=/etc \
		--libdir=lib/$(DEB_HOST_MULTIARCH) --bindir=lib/nntrainer/bin \
		--includedir=include -Dinstall-app=true \
		-Dreduce-tolerance=$(ENABLE_REDUCE_TOLERANCE) \
		-Denable-debug=$(ENABLE_DEBUG) \
		-Dml-api-support=enabled \
		-Denable-nnstreamer-tensor-filter=enabled \
		-Denable-nnstreamer-tensor-trainer=enabled \
                -Denable-nnstreamer-backbone=true \
                -Dcapi-ml-common-actual=capi-ml-common \
                -Dcapi-ml-inference-actual=capi-ml-inference \
                -Denable-capi=enabled \
		$(MESON_ARM_ARGS) \
		build --wrap-mode=nodownload

override_dh_auto_build:
	ninja -C build

override_dh_auto_test:
	meson test -C build -t 2.0 --print-errorlogs

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp ninja -C build install

# meson installs the compute backend headers of the architecture it built
# for, so the set cannot be spelled out in the architecture independent
# .install file: naming a header that was not built makes dh_install fail,
# and leaving an installed one out makes dh_missing fail. Install whatever
# the build produced instead.
NNTR_BACKEND_INC = debian/tmp/usr/include/nntrainer
NNTR_BACKEND_HEADERS = $(wildcard $(NNTR_BACKEND_INC)/x86_compute_backend.h $(NNTR_BACKEND_INC)/avx2_impl.h)
NNTR_BACKEND_HEADERS += $(wildcard $(NNTR_BACKEND_INC)/arm_compute_backend.h $(NNTR_BACKEND_INC)/armv7_neon.h)
NNTR_BACKEND_HEADERS += $(wildcard $(NNTR_BACKEND_INC)/mask_neon.h $(NNTR_BACKEND_INC)/neon_impl.h)
NNTR_BACKEND_HEADERS += $(wildcard $(NNTR_BACKEND_INC)/neon_mathfun.h $(NNTR_BACKEND_INC)/neon_mathfun.hxx)
NNTR_BACKEND_HEADERS += $(wildcard $(NNTR_BACKEND_INC)/hgemm*.h $(NNTR_BACKEND_INC)/matrix_transpose*.h)
NNTR_BACKEND_HEADERS += $(wildcard $(NNTR_BACKEND_INC)/kleidiai_*.h $(NNTR_BACKEND_INC)/kai_*.h)

override_dh_install:
	dh_install
	test -z "$(strip $(NNTR_BACKEND_HEADERS))" || dh_install -pnntrainer-dev $(NNTR_BACKEND_HEADERS) usr/include/nntrainer

override_dh_missing:
	dh_missing --fail-missing

override_dh_clean:
	dh_clean $@
